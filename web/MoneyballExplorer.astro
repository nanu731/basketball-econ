---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import DefinitionHelp from './DefinitionHelp.astro';
import { INDEX_URL, INDEX_BYTE_LIMIT, VIEW_BYTE_LIMIT, parseJSONBytes, validateIndex, validateViewBundle, viewLabel, metricLabel, salaryCoverage, decimal, money, percentile, readableReason, teamName, type Bundle } from './moneyball';
let data: Bundle | null = null;
let state = 'Reviewed salary and contribution records are not available. No player findings are shown.';
try {
  const rawIndex = await readFile(resolve(process.cwd(), `public${INDEX_URL}`));
  const index = validateIndex(parseJSONBytes(rawIndex, INDEX_BYTE_LIMIT));
  const initial = index.views.find(v => v.id === index.defaultView)!;
  const rawView = await readFile(resolve(process.cwd(), `public${initial.url}`));
  data = validateViewBundle(parseJSONBytes(rawView, VIEW_BYTE_LIMIT), initial, index.dataVersion);
  state = `${data.publication.status === 'private-preview' ? 'Private preview' : 'Reviewed export'} · ${viewLabel(data.views[0])}`;
} catch (error) {
  if ((error as NodeJS.ErrnoException).code !== 'ENOENT') state = 'The player export failed validation. No results are shown; the export must be corrected.';
}
---

<section class="moneyball figure" aria-label="NBA salary and contribution explorer" data-moneyball>
  <div class="mb-heading"><p class="mb-small" role="status" aria-live="polite" data-mb-status>{state}</p></div>
  <form aria-label="Explore player value">
    <fieldset disabled data-mb-controls class="mb-controls">
      <legend class="mb-sr">Player comparison controls</legend>
      <div class="mb-primary">
        <div class="mb-search" data-mb-search-shell>
          <label for="mb-player-search">Search player</label>
          <div class="combobox-shell">
            <input type="search" id="mb-player-search" data-mb-search autocomplete="off" placeholder="Search by name" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="mb-player-suggestions" aria-describedby="mb-search-result" />
            <div id="mb-player-suggestions" class="suggestion-menu" data-mb-suggestions role="listbox" aria-label="Matched players in this view" hidden></div>
          </div>
        </div>
        <label class="mb-metric-control">Contribution<select data-mb-metric><option value="war">Season contribution · WAR</option><option value="lebron">Impact when playing · LEBRON</option></select></label>
      </div>
      <p class="mb-small mb-search-help" id="mb-search-result" role="status" aria-live="polite" data-mb-search-result>Type two or more characters to find a player.</p>
      <details class="mb-filters" data-mb-context-controls>
        <summary>Change season, team or time span</summary>
        <div class="mb-secondary mb-context-controls">
        <label>Season ending<select data-mb-season aria-label="Season ending"><option value="">Awaiting data</option></select></label>
        <label>Time span<select data-mb-window><option value="1">One season</option><option value="3">Three seasons</option><option value="5">Five seasons</option></select></label>
        <label class="mb-team-control">Team membership<select data-mb-team><option value="">All teams</option></select></label>
        </div>
      </details>
    </fieldset>
  </form>
  <figure aria-labelledby="mb-chart-title" aria-describedby="mb-chart-guide mb-caption">
    <h2 id="mb-chart-title" class="mb-sr">Explore player value</h2>
    <p id="mb-chart-guide" class="mb-guide"><strong>Above the line:</strong> more contribution than the line estimates at that salary. <strong>Below:</strong> less.</p>
    <div class="mb-chart-tools"><p class="mb-small" data-mb-period>Regular season · awaiting data</p></div>
    <div class="mb-chart-layout">
      <div class="mb-plot">
        <p class="mb-axis mb-y"><span data-mb-war-help><DefinitionHelp id="mb-war" label="WAR">LEBRON WAR estimates wins above a replacement-level player: a readily available fill-in player. Zero is that replacement baseline. It adds estimated contribution over playing time, including availability; it is not the team's actual wins.</DefinitionHelp></span><span data-mb-lebron-help hidden><DefinitionHelp id="mb-lebron" label="LEBRON">LEBRON names an impact statistic, rather than the player LeBron James. It estimates on-court impact in points per 100 possessions, not points actually scored. A possession is a team's turn with the ball; per 100 puts players on the same rate scale. Zero means league-average impact. The rate does not represent a season-long total.</DefinitionHelp></span><span class="mb-axis-copy"><span data-mb-y-label>Estimated wins · season total</span><span data-mb-metric-note>Zero: a readily available fill-in player.</span></span></p>
        <div class="mb-stage">
          <svg role="img" data-mb-chart aria-label="Salary and measured contribution" viewBox="0 0 300 420"><title>No interactive records loaded</title></svg>
          <div class="mb-empty" data-mb-empty><h3>Player comparisons unavailable</h3><p>Verified, matched records are required before dots or a league reference can appear.</p><button type="button" data-mb-retry>Retry data</button></div>
        </div>
        <p class="mb-axis mb-x" data-mb-x-label>Salary · US dollars</p>
      </div>
      <section class="mb-selection" aria-label="Selected player">
        <h3 data-mb-selection-name aria-live="polite" hidden>Player comparison</h3>
        <p data-mb-selection>Search for a player or select a dot.</p>

        <div data-mb-comparison hidden>
          <dl class="mb-comparison">
            <div><dt>Measured contribution</dt><dd data-mb-selected-contribution></dd></div>
            <div><dt>Reference at this pay</dt><dd data-mb-selected-reference></dd></div>
            <div><dt><DefinitionHelp id="mb-residual" label="Above / below the line">Measured contribution minus the visible league reference at this player's pay. A larger gap gives a higher Value for pay percentile.</DefinitionHelp></dt><dd data-mb-selected-gap></dd></div>
          </dl>
          <dl class="mb-comparison mb-pay-rank">
            <div><dt>Reported pay</dt><dd data-mb-selected-salary></dd></div>
            <div><dt><DefinitionHelp id="mb-value-percentile" label="Value for pay rank">A rank on a 0–100 scale comparing the gap from the salary reference with eligible matched players in this view. A larger gap means a higher rank. The cohort includes the selected player; tied gaps share a midpoint rank. Team and search filters never change it.</DefinitionHelp></dt><dd data-mb-selected-percentile></dd></div>
          </dl>
          <div class="mb-selection-meta"><p class="mb-small" data-mb-selected-cohort></p><p class="mb-small" data-mb-selected-observed hidden></p></div>
          <p class="mb-small">Higher means a larger contribution gap for the pay. This ranks the gap, not talent or return per dollar.</p>
          <details class="mb-player-details"><summary>Playing time and records</summary><p class="mb-small" data-mb-selected-details></p></details>
        </div>
        <div class="mb-selection-actions"><button type="button" data-mb-find-player disabled>Find a player</button>
        <div class="mb-examples" data-mb-examples hidden><span>Try a player:</span><div data-mb-example-buttons></div></div>
        </div>
      </section>
  <p class="mb-small mb-note" data-mb-window-note>One dot compares the same player's matched salary and contribution. Controls become available after the selected view passes validation.</p>
  <p class="mb-small mb-note" data-mb-coverage-summary></p>
    </div>
    <div class="mb-legend" aria-label="Chart legend"><span><i class="mb-dot-key" data-mb-peer-key aria-hidden="true"></i><DefinitionHelp id="mb-matched" label="Matched player">One player whose salary and contribution records cover the same seasons and pass the inclusion rules. Missing or ineligible records stay out of the comparison.</DefinitionHelp></span><span data-mb-selected-key hidden><i class="mb-selected-key" aria-hidden="true"></i>Selected player</span><span><i class="mb-line-key" aria-hidden="true"></i><DefinitionHelp id="mb-reference" label="Salary reference">A line fitted to the league's eligible matched records. It compares estimated contribution at different salaries. A player's above/below value is the vertical contribution gap from this line at that player's pay. Filters never refit it.</DefinitionHelp></span><span><i class="mb-band-key" aria-hidden="true"></i><DefinitionHelp id="mb-band" label="Range for the reference">The shaded band shows where the fitted league line might sit, treating the provider's player scores as fixed. It does not show uncertainty about an individual player's impact. Technical interval details are in the model notes.</DefinitionHelp></span></div>
    <figcaption id="mb-caption">The league reference stays fixed under filters. Salary comparisons do not establish cause. Underlined terms open definitions.</figcaption>
  </figure>
      <details class="mb-filters">
        <summary>Salary units and reset</summary>
        <div class="mb-secondary">
          <label>Salary units<select disabled data-mb-units aria-describedby="mb-salary-help"><option value="usd">US dollars</option><option value="share">% of salary cap</option></select></label>
          <button type="button" disabled data-mb-reset>Reset view</button>
        </div>
        <p class="mb-small mb-note" id="mb-salary-help"><DefinitionHelp id="mb-cap" label="Salary cap / share">The salary cap is the league's season-specific payroll benchmark. Cap share is reported salary divided by that cap. Dollar amounts for one season are the reported salary without inflation adjustment; they are not independently verified cash payments.</DefinitionHelp> puts pay in context. Multi-season dollars use the ending season's cap.</p>
      </details>
  <p class="mb-small mb-team" data-mb-team-summary hidden>Team totals count only matched salary and WAR that can be assigned to that team. A traded player's full record may appear among the dots while remaining excluded from the team total.</p>
  <details class="mb-extra" data-mb-extra>
    <summary>What does $1 million more in salary correspond to?</summary>
    <p>Choose two salaries $1 million apart and compare the contribution estimated by the league line.</p>
    <p class="mb-small" data-mb-contrast-context></p>
    <label class="mb-spending">Choose the lower salary: <span data-mb-contrast-start></span><input id="mb-spending" type="range" min="0" max="0" step="1" value="0" data-mb-spending disabled /></label>
    <table class="mb-scenarios">
      <caption class="mb-sr">Two salaries on the fitted league line and their modeled contribution</caption>
      <thead><tr><th scope="col" id="mb-scenario-lower">Lower salary</th><th scope="col" id="mb-scenario-higher">Higher salary · $1m more</th></tr></thead>
      <tbody>
        <tr><td headers="mb-scenario-lower" data-mb-contrast-lower></td><td headers="mb-scenario-higher" data-mb-contrast-higher></td></tr>
        <tr><th colspan="2" id="mb-scenario-contribution">Modeled contribution · <span data-mb-contrast-unit></span></th></tr>
        <tr><td headers="mb-scenario-lower mb-scenario-contribution" data-mb-contrast-lowerContribution></td><td headers="mb-scenario-higher mb-scenario-contribution" data-mb-contrast-higherContribution></td></tr>
      </tbody>
    </table>
    <p class="mb-small"><DefinitionHelp id="mb-modeled-contribution" label="Modeled contribution"><span data-mb-contrast-unitNote></span> These are fitted league-line estimates, not observed players.</DefinitionHelp> estimates are rounded; the difference uses unrounded values.</p>
    <div class="mb-pay-comparison"><p>Difference for the extra $1 million</p><p data-mb-contrast-readout>No salary comparison is loaded.</p></div>
    <p class="mb-small"><DefinitionHelp id="mb-difference-range" label="Estimated range for this difference">The range uses both fitted points jointly and treats the supplied player scores as fixed. It does not include uncertainty in the provider’s player scores.</DefinitionHelp>: <strong data-mb-contrast-range></strong></p>
    <p class="mb-small">This range concerns the league-line difference, not an individual player’s impact.</p>
    <p class="mb-small" data-mb-contrast-shape></p>
    <p class="mb-small">This comparison does not predict the effect of giving a player a raise.</p>
    <details class="mb-contrast-details"><summary>Support, basis and unrounded estimates</summary>
      <dl class="mb-contrast-audit">
        <dt>Nearby matched players</dt><dd data-mb-contrast-support></dd>
        <dt>Unrounded fitted estimates and exported difference</dt><dd data-mb-contrast-precision></dd>
      </dl>
      <p class="mb-small">Both salaries must have enough nearby matched observations. The range uses the two fitted points jointly; it is not obtained by subtracting two separate interval endpoints. Salary basis and provider scores follow the current view; source records and model details are below.</p>
    </details>
  </details>
  <details data-mb-live-table hidden class="mb-records">
    <summary>Player records · <span class="mb-small" data-mb-count></span></summary>
    <div class="mb-table-scroll" role="region" aria-label="Filtered player records, scroll horizontally" tabindex="0">
      <table><caption class="mb-sr">Current matched player records. Select a name for details. Both contribution measures are always shown.</caption><thead><tr><th scope="col">Player</th><th scope="col">Teams</th><th scope="col"><DefinitionHelp id="mb-observed" label="Observed / window">The number of active matched seasons included for this player out of the selected span. A 2/3 entry uses two matched seasons within a three-season window; averages cover those two seasons.</DefinitionHelp></th><th scope="col" data-mb-table-cost>Compensation (USD)</th><th scope="col">LEBRON rate</th><th scope="col" data-mb-table-war>WAR total</th><th scope="col" data-mb-table-residual>Above / below reference</th><th scope="col" data-mb-table-percentile>Value for pay percentile</th></tr></thead><tbody data-mb-rows></tbody></table>
    </div>
  </details>
  <section data-mb-snapshot aria-labelledby="mb-snapshot-title" class="mb-snapshot">
    <h3 id="mb-snapshot-title">Default build snapshot</h3>
    {data ? <>
      <p class="mb-small">Build snapshot: {data.dataVersion}. This table contains the default exported window and both metrics. Other seasons and windows load when selected and require JavaScript; their observations have not been checked by this build.</p>
      {data.views.map(v => <details>
        <summary>Player records · {viewLabel(v)}</summary>
        <p class="mb-small">{v.coverage.matched} matched salary records among {v.coverage.eligible} player records meeting playing-time and contribution-metric rules. {salaryCoverage(v)}{v.coverage.excluded.length > 0 && ` Primary exclusion reasons: ${v.coverage.excluded.map(e => `${e.count}: ${readableReason(e.reason)}`).join('; ')}`}</p>
        <p class="mb-small">{v.window === 1 ? 'One player-season per row; nominal annual compensation and season-total WAR.' : `Average annual end-season cap-equivalent compensation and WAR per observed matched active season; possession-weighted LEBRON. ${v.window} possible seasons per player.`} Negative contribution remains visible.</p>
        <div class="mb-table-scroll" role="region" aria-label={`${viewLabel(v)} player records, scroll horizontally`} tabindex="0">
          <table><caption>{viewLabel(v)} · complete matched export</caption><thead><tr><th scope="col">Player / NBA ID</th><th scope="col">Teams</th><th scope="col"><DefinitionHelp id={`mb-observed-build-${v.id}`} label="Observed seasons">The active matched seasons included for this player. The count after them gives observed seasons out of the selected window. Averages use the observed matched seasons.</DefinitionHelp></th><th scope="col">{v.window === 1 ? 'Compensation (USD)' : 'Avg compensation (end-cap USD)'}</th><th scope="col">% cap</th><th scope="col">LEBRON rate</th><th scope="col">LEBRON above / below reference</th><th scope="col">LEBRON Value for pay percentile</th><th scope="col">{v.window === 1 ? 'WAR total' : 'Avg WAR / observed season'}</th><th scope="col">WAR above / below reference</th><th scope="col">WAR Value for pay percentile</th><th scope="col">Evidence notes</th></tr></thead><tbody>{v.players.map(p => <tr><th scope="row">{p.name}<small>{p.id}</small></th><td>{p.teams.join(', ')}</td><td>{p.observedSeasons.join(', ')} ({p.observedSeasons.length}/{v.window})</td><td>{money(p.salaryUsd)}</td><td>{decimal(p.salaryCapShare * 100)}%</td><td>{decimal(p.lebron)}</td><td>{decimal(p.residual.lebron)}</td><td>{percentile(p.valuePercentile.lebron)}</td><td>{decimal(p.war)}</td><td>{decimal(p.residual.war)}</td><td>{percentile(p.valuePercentile.war)}</td><td>{p.flags.length ? p.flags.map(readableReason).join('; ') : 'No additional flags supplied'}</td></tr>)}</tbody></table>
        </div>
        <details><summary>Team attribution and reference evidence</summary><p class="mb-small">Coverage note: {v.coverage.note}</p>
          {v.teams.map(t => <p class="mb-small">{teamName(t.team, v.endSeason)}: {t.status === 'unavailable' ? 'compensation and WAR unavailable' : `${money(t.salaryUsd!)} compensation; ${decimal(t.war!)} WAR`} {v.window > 1 ? 'per year over the full window' : 'in the season'}. {t.attributablePlayerSeasons}/{t.eligiblePlayerSeasons} matched player-seasons assigned to this club. Broader active-source audit: {t.excludedTradeCount} trade/unknown-allocation flags and {t.excludedMissingCount} missing-data flags. Those audit counts may overlap and include ineligible rows; they do not partition the matched sample. {t.note}</p>)}
          {(['lebron', 'war'] as const).map(m => <div><h4>{metricLabel(m, v)}</h4><p>{v.models[m].name}. {v.models[m].method} {v.models[m].validation} {v.models[m].intervalLabel}</p></div>)}
        </details>
      </details>)}
    </> : <p>No reviewed records are available. Missing salary or contribution is never replaced with zero.</p>}
  </section>
  <section class="mb-methods" aria-labelledby="mb-about-title">
    <h2 id="mb-about-title">About the data and model</h2>
    <details><summary>Contribution measures</summary><p><strong>WAR</strong> estimates wins above a readily available fill-in player over playing time; zero is that replacement baseline. <strong>LEBRON</strong> is the name of an impact statistic. It estimates impact per 100 possessions, or turns with the ball; zero means league average. It is a rate, not points actually scored. <a href="https://www.bball-index.com/lebron-introduction/">Provider explanation</a>.</p></details>
    <details><summary>How the model works</summary><p>The analysis fits a league-wide relationship between matched compensation and each contribution measure. The above / below reference value is the vertical gap between a player's dot and that curve. It stays fixed under team or player filters.</p><p>For multi-season windows, salary and both contribution measures cover exactly the same observed matched active seasons. A player can have fewer observed seasons than the selected window. Read that count beside the player before comparing averages. WAR and salary cap share average the observed matched active seasons; LEBRON uses the provider's possession counts as weights. Dollar views multiply average cap share by the ending-season salary cap. Team annual averages instead divide attributable player-season totals by the full selected window length.</p>{data && <><p>{data.definitions.eligibility}</p>{data.views.map(v => <details><summary>{viewLabel(v)} model and validation</summary>{(['lebron', 'war'] as const).map(m => <p><strong>{m.toUpperCase()}:</strong> {v.models[m].name}. {v.models[m].method} {v.models[m].validation}</p>)}</details>)}</>}</details>
    <details><summary>Salary, team totals and contract rules</summary><p>Salary cap share divides reported pay by that season's league cap, putting seasons on a common spending scale. Dollar views use nominal compensation for one season and ending-season cap-equivalent annual averages for multi-season windows.</p><p>Rookie scales, minimums and maximums constrain contracts; cap normalization preserves those constraints. Team membership shows the full player record. Team totals use only attributable matched salary and summed WAR, and show exclusions for traded or missing allocations. Rate values are never summed.</p>{data && <p>{data.definitions.salary}</p>}</details>
    <details><summary>Uncertainty and limitations</summary>
      <p>The shaded range describes how much the fitted league comparison varies when matched players are sampled again. It treats the supplied player scores as fixed and keeps the chosen type of curve. It does not measure uncertainty in a player's own impact, guarantee coverage of the whole curve at once, or include uncertainty from choosing the model. The extra-$1m range concerns the difference between two fitted points. These comparisons do not show that higher pay causes higher performance.</p>
      <details><summary>Exact uncertainty and validation records</summary>
        <p class="mb-small">Terms: <DefinitionHelp id="mb-case-bootstrap" label="case bootstrap">Draw players again from the matched cohort, allowing a player to appear more than once, and refit the salary reference. The supplied scores and chosen curve type stay fixed.</DefinitionHelp>; <DefinitionHelp id="mb-standard-error" label="SE">Standard error: the spread of the refitted estimates across the repeated player samples. It is not measurement error in an individual player's impact score.</DefinitionHelp>; <DefinitionHelp id="mb-post-selection" label="post-selection coverage">How intervals perform after the data have been used to choose a curve type. These bands keep the chosen type fixed and do not account for uncertainty from that choice.</DefinitionHelp>.</p>
        <p class="mb-small">Pointwise means one salary position at a time; conditional means the supplied scores are treated as fixed. A one-SE rule prefers a simpler model close to the best held-out error. REML tunes curve smoothness; model family means the type of curve.</p>
        {data ? <><p>{data.definitions.uncertainty}</p><ul>{data.definitions.limitations.map(l => <li>{l}</li>)}</ul></> : <p>The salary/contribution match, complete season coverage and model evidence must pass validation before results can appear. This preview has no numerical findings.</p>}
        <p class="mb-small" data-mb-view-evidence>No interactive view evidence loaded. Default build evidence is in this section.</p>
      </details>
    </details>
    <details><summary>Default build sources and release status</summary>{data ? <><p>{data.publication.note}</p><ul>{data.sources.map(s => <li><a href={s.url} rel="noreferrer">{s.label}</a> · retrieved {s.retrieved}</li>)}</ul><details class="mb-source-versions"><summary>Source version identifiers</summary><ul>{data.sources.map(s => <li>{s.label}: <code>{s.version}</code></li>)}</ul></details></> : <p>No publishable data bundle is loaded. The selected contribution measures are BBall Index's LEBRON and LEBRON WAR. Free access alone does not establish permission to republish.</p>}<p><a href="https://github.com/nanu731/basketball-econ">Analysis and reproduction code</a>. Regular seasons only; playoffs are deferred. The <a href="https://github.com/nanu731/basketball-econ/blob/main/LICENSE">MIT license</a> covers original code, not upstream data or metrics. Free access is separate from permission to redistribute.</p></details>
  <p class="mb-small" data-mb-model></p>
  <details><summary>Current view sources</summary><p class="mb-small">Links and retrieval dates for the latest validated interactive view.</p><ul data-mb-view-sources></ul><details class="mb-source-versions"><summary>Source version identifiers</summary><ul data-mb-view-source-versions></ul></details></details>
  <details><summary>Coverage of the selected view</summary><p class="mb-small mb-coverage" data-mb-coverage>Interactive coverage will appear after a view loads. The default build table includes its own coverage.</p></details>
  <details data-mb-team-audit-panel hidden><summary>Team coverage audit</summary><p class="mb-small" data-mb-team-audit>No team audit is loaded.</p></details>
  <details><summary>How the Value for pay percentile is calculated</summary><p>For each contribution measure and window, the percentile compares the player's gap from the salary reference with all eligible matched players in that view. Larger gaps rank higher. It counts every smaller gap and half of every exact tie, including the player, then divides by the full cohort size. Only the displayed percentile is rounded to one decimal.</p><p>Ranking uses the exact saved numbers for the gaps, not the rounded values on the page. A zero gap need not be the 50th percentile; the endpoints need not be 0 and 100. Filters preserve the full league cohort. Gaps can vary more at some salary levels than others. This rank does not measure how unusual a gap is, uncertainty, overall talent, causal value or return per dollar.</p></details>
  </section>
  <noscript><p>JavaScript is off. Read the default build table and model explanations on this page; interactive selection is unavailable.</p></noscript>

</section>

<script>
  import { mountMoneyball } from './moneyball';
  document.querySelectorAll<HTMLElement>('[data-moneyball]').forEach(mountMoneyball);
</script>

<style>
  /* Tighten only this project's opening so the chart stays in the first viewport. */
  :global(body:has(.moneyball) .draft-flag) { display: none; }
  :global(body.project--compact:has(.moneyball) .question-band.band) { padding-block: var(--space-xs); }
  :global(body:has(.moneyball) .question-band .project-question) { margin-top: var(--space-xs); font-size: 1.125rem; line-height: 1.4; }
  :global(body.project--compact:has(.moneyball) .prose-band) { padding-block: var(--space-s) var(--space-l); }
  :global(body:has(.moneyball) .prose-band .band-inner) { max-width: 90rem; margin-inline: auto; }
  .moneyball.figure { margin-block: 0; }
  .moneyball { color: var(--green); --mb-rule: 1px solid var(--green); }
  .moneyball figure { margin: 0; }
  .mb-heading { padding-block: 0 var(--space-xs); }
  .mb-heading p { margin: 0; }
  .mb-small, figcaption { font-size: var(--type-small); line-height: 1.5; }
  .mb-heading .mb-small { max-width: 65ch; }
  .mb-controls { border: 0; border-top: var(--mb-rule); margin: 0; padding: 0; min-width: 0; }
  .mb-primary { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-s); padding-block: var(--space-xs); }
  .mb-secondary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-xs) var(--space-s); padding-block: var(--space-xs); }
  .mb-context-controls { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .moneyball .mb-filters { margin: 0; border-top: var(--mb-rule); }
  .moneyball .mb-filters > summary { font: 1rem/1.4 var(--font-body); box-sizing: border-box; min-height: 44px; padding-block: var(--space-2xs); }
  .mb-controls label, .mb-secondary label, .mb-spending { display: flex; flex-direction: column; gap: var(--space-2xs); min-width: 0; font-size: var(--type-small); }
  .mb-search { min-width: 0; }
  .mb-search > label { margin-bottom: var(--space-2xs); }
  .combobox-shell { position: relative; min-width: 0; }
  .moneyball .mb-search-help { margin: 0 0 var(--space-2xs); }
  .suggestion-menu { position: absolute; z-index: 10; inset-block-start: 100%; inset-inline: 0; max-height: 18rem; overflow-y: auto; overscroll-behavior: contain; box-sizing: border-box; border: var(--mb-rule); border-top: 0; background: var(--cream); }
  .suggestion-menu :global(.suggestion-option), .suggestion-menu :global(.no-results) { margin: 0; padding: var(--space-xs) var(--space-s); }
  .suggestion-menu :global(.suggestion-option) { min-height: 44px; box-sizing: border-box; border-top: 1px solid var(--sand); cursor: pointer; touch-action: manipulation; }
  .suggestion-menu :global(.suggestion-option:first-child) { border-top: 0; }

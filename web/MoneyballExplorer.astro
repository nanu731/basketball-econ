---
import { readFile } from 'node:fs/promises';
import { resolve } from 'node:path';
import DefinitionHelp from './DefinitionHelp.astro';
import { INDEX_URL, INDEX_BYTE_LIMIT, VIEW_BYTE_LIMIT, parseJSONBytes, validateIndex, validateViewBundle, viewLabel, metricLabel, salaryCoverage, decimal, money, percentile, readableReason, teamName, type Bundle } from './moneyball';
let data: Bundle | null = null;
let state = 'Reviewed salary and contribution records are not available. No player findings are shown.';
try {
  const rawIndex = await readFile(resolve(process.cwd(), `public${INDEX_URL}`));
  const index = validateIndex(parseJSONBytes(rawIndex, INDEX_BYTE_LIMIT));
  const initial = index.views.find(v => v.id === index.defaultView)!;
  const rawView = await readFile(resolve(process.cwd(), `public${initial.url}`));
  data = validateViewBundle(parseJSONBytes(rawView, VIEW_BYTE_LIMIT), initial, index.dataVersion);
  state = `${data.publication.status === 'private-preview' ? 'Private preview' : 'Reviewed export'} · ${viewLabel(data.views[0])}`;
} catch (error) {
  if ((error as NodeJS.ErrnoException).code !== 'ENOENT') state = 'The player export failed validation. No results are shown; the export must be corrected.';
}
---

<section class="moneyball figure" aria-label="NBA salary and contribution explorer" data-moneyball>
  <div class="mb-heading"><p class="label">NBA / Regular seasons</p><p class="mb-small" role="status" aria-live="polite" data-mb-status>{state}</p></div>
  <form aria-label="Explore player value">
    <fieldset disabled data-mb-controls class="mb-controls">
      <legend class="mb-sr">Player comparison controls</legend>
      <div class="mb-primary">
        <label>Contribution<select data-mb-metric><option value="war">WAR · estimated wins</option><option value="lebron">LEBRON · rate</option></select></label>
        <label>Season ending<select data-mb-season aria-label="Season ending"><option value="">Awaiting data</option></select></label>
      </div>
      <details class="mb-filters">
        <summary>Find a player or filter the chart</summary>
        <div class="mb-secondary">
          <label>Window<select data-mb-window><option value="1">One season</option><option value="3">Three seasons</option><option value="5">Five seasons</option></select></label>
          <label>Salary units<select data-mb-units aria-describedby="mb-salary-help"><option value="usd">US dollars</option><option value="share">% of salary cap</option></select></label>
          <label>Team membership<select data-mb-team><option value="">All teams</option></select></label>
          <label class="mb-search">Find a player<input type="search" data-mb-search aria-describedby="mb-search-result" autocomplete="off" placeholder="Search by name" /></label>
          <label class="mb-picker">Choose a player<select data-mb-player aria-describedby="mb-search-result"><option value="">Choose a player</option></select><span class="mb-small" id="mb-search-result" role="status" aria-live="polite" data-mb-search-result>Search by name, then choose if several players match.</span></label>
          <button type="button" data-mb-reset>Reset view</button>
        </div>
        <p class="mb-small mb-note" id="mb-salary-help"><DefinitionHelp id="mb-cap" label="Salary cap / share">The salary cap is the league's season-specific payroll benchmark. Cap share is reported salary divided by that cap. Dollar amounts for one season are the reported salary without inflation adjustment; they are not independently verified cash payments.</DefinitionHelp> puts pay in context. Multi-season dollars use the ending season's cap.</p>
        <p class="mb-small mb-note" data-mb-window-note>One dot compares the same player's matched salary and contribution. Controls become available after the selected view passes validation.</p>
      </details>
    </fieldset>
  </form>
  <p class="mb-small mb-phone-hint">On a phone, search or choose a player for exact values.</p>
  <figure aria-labelledby="mb-chart-title" aria-describedby="mb-caption">
    <h2 id="mb-chart-title" class="mb-sr">Explore player value</h2>
    <div class="mb-chart-layout">
      <div class="mb-plot">
        <p class="mb-axis mb-y"><span data-mb-war-help><DefinitionHelp id="mb-war" label="WAR">LEBRON WAR estimates wins above a replacement-level player: a readily available fill-in player. Zero is that replacement baseline. It adds estimated contribution over playing time, including availability; it is not the team's actual wins.</DefinitionHelp></span><span data-mb-lebron-help hidden><DefinitionHelp id="mb-lebron" label="LEBRON">LEBRON names an impact statistic, rather than the player LeBron James. It estimates on-court impact in points per 100 possessions, not points actually scored. A possession is a team's turn with the ball; per 100 puts players on the same rate scale. Zero means league-average impact. The rate does not represent a season-long total.</DefinitionHelp></span><span data-mb-y-label>estimated wins · season total</span></p>
        <div class="mb-stage">
          <svg role="img" data-mb-chart aria-label="Salary and measured contribution" viewBox="0 0 300 340"><title>No interactive records loaded</title></svg>
          <div class="mb-empty" data-mb-empty><h3>Player comparisons unavailable</h3><p>Verified, matched records are required before dots or a league reference can appear.</p><button type="button" data-mb-retry>Retry data</button></div>
        </div>
        <p class="mb-axis mb-x" data-mb-x-label>Annual compensation · US dollars →</p>
      </div>
      <aside class="mb-selection" aria-label="Selected player">
        <h3 data-mb-selection-name aria-live="polite">Player comparison</h3>
        <p data-mb-selection>Search for a player or tap a dot. Use the player selector for an exact comparison.</p>
        <div data-mb-comparison hidden>
          <dl class="mb-comparison">
            <div><dt>Reported pay</dt><dd data-mb-selected-salary></dd></div>
            <div><dt>Measured contribution</dt><dd data-mb-selected-contribution></dd></div>
            <div><dt><DefinitionHelp id="mb-residual" label="Gap from salary reference">Measured contribution minus the visible league reference at this player's pay. A larger gap gives a higher Value for pay percentile.</DefinitionHelp></dt><dd data-mb-selected-gap></dd></div>
            <div><dt><DefinitionHelp id="mb-value-percentile" label="Value for pay percentile">A rank on a 0–100 scale comparing the gap from the salary reference with eligible matched players in this view. A larger gap means a higher rank. The cohort includes the selected player; tied gaps share a midpoint rank. Team and search filters never change it.</DefinitionHelp></dt><dd data-mb-selected-percentile></dd></div>
          </dl>
          <p class="mb-small mb-cohort" data-mb-selected-cohort></p>
          <p class="mb-small" data-mb-selected-observed hidden></p>
          <details class="mb-player-details"><summary>Playing time and record details</summary><p class="mb-small" data-mb-selected-details></p></details>
        </div>
        <p class="mb-small">The percentile ranks the gap, not overall talent, causal value or return per dollar.</p>
      </aside>
    </div>
    <div class="mb-legend" aria-label="Chart legend"><span><i class="mb-dot-key" aria-hidden="true"></i><DefinitionHelp id="mb-matched" label="Matched player">One player whose salary and contribution records cover the same seasons and pass the inclusion rules. Missing or ineligible records stay out of the comparison.</DefinitionHelp></span><span><i class="mb-line-key" aria-hidden="true"></i><DefinitionHelp id="mb-reference" label="League reference">A line fitted to the league's eligible matched records. It compares estimated contribution at different salaries. A player's above/below value is the vertical contribution gap from this line at that player's pay. Filters never refit it.</DefinitionHelp></span><span><i class="mb-band-key" aria-hidden="true"></i><DefinitionHelp id="mb-band" label="Estimated range for the curve">The shaded band shows where the fitted league line might sit, treating the provider's player scores as fixed. It does not show uncertainty about an individual player's impact. Technical interval details are in the model notes.</DefinitionHelp></span></div>
    <figcaption id="mb-caption">Above the line means more measured contribution than the salary reference predicts. Filters keep the league comparison fixed. Pay does not establish cause, and individual player uncertainty is unavailable. <span class="mb-help-hint">Tap or click an underlined term for its meaning.</span></figcaption>
  </figure>
  <p class="mb-small mb-team" data-mb-team-summary hidden>Team totals count only matched salary and WAR that can be assigned to that team. A traded player's full record may appear among the dots while remaining excluded from the team total.</p>
  <details class="mb-extra" data-mb-extra>
    <summary>What accompanies an extra $1 million?</summary>
    <p>This compares two salary amounts $1m apart on the same fitted line. It does not predict that paying a player $1m more will create this contribution. Multi-season windows compare average annual pay in the ending season's cap-equivalent dollars.</p>
    <svg role="img" data-mb-contrast aria-label="Supported extra million dollar curve differences" viewBox="0 0 300 200"><title>No contrast records loaded</title></svg>
    <label class="mb-spending">Starting compensation position<input type="range" min="0" max="0" step="1" value="0" data-mb-spending disabled /></label>
    <p data-mb-contrast-readout>No supported spending comparison is loaded.</p>
    <p class="mb-small">An estimate appears only where enough nearby player salaries support both amounts. Unsupported positions stay missing. The range describes uncertainty in the difference between the two fitted points, treating the provider scores as fixed.</p>
  </details>
  <details data-mb-live-table hidden class="mb-records">
    <summary>Player records · <span class="mb-small" data-mb-count></span></summary>
    <div class="mb-table-scroll" role="region" aria-label="Filtered player records, scroll horizontally" tabindex="0">
      <table><caption class="mb-sr">Current matched player records. Select a name for details. Both contribution measures are always shown.</caption><thead><tr><th scope="col">Player</th><th scope="col">Teams</th><th scope="col"><DefinitionHelp id="mb-observed" label="Observed / window">The number of active matched seasons included for this player out of the selected span. A 2/3 entry uses two matched seasons within a three-season window; averages cover those two seasons.</DefinitionHelp></th><th scope="col" data-mb-table-cost>Compensation (USD)</th><th scope="col">LEBRON rate</th><th scope="col" data-mb-table-war>WAR total</th><th scope="col" data-mb-table-residual>Above / below reference</th><th scope="col" data-mb-table-percentile>Value for pay percentile</th></tr></thead><tbody data-mb-rows></tbody></table>
    </div>
  </details>
  <section data-mb-snapshot aria-labelledby="mb-snapshot-title" class="mb-snapshot">
    <h3 id="mb-snapshot-title">Default build snapshot</h3>
    {data ? <>
      <p class="mb-small">Build snapshot: {data.dataVersion}. This table contains the default exported window and both metrics. Other seasons and windows load when selected and require JavaScript; their observations have not been checked by this build.</p>
      {data.views.map(v => <details>
        <summary>Player records · {viewLabel(v)}</summary>
        <p class="mb-small">{v.coverage.matched} matched salary records among {v.coverage.eligible} player records meeting playing-time and contribution-metric rules. {salaryCoverage(v)}{v.coverage.excluded.length > 0 && ` Primary exclusion reasons: ${v.coverage.excluded.map(e => `${e.count}: ${readableReason(e.reason)}`).join('; ')}`}</p>
        <p class="mb-small">{v.window === 1 ? 'One player-season per row; nominal annual compensation and season-total WAR.' : `Average annual end-season cap-equivalent compensation and WAR per observed matched active season; possession-weighted LEBRON. ${v.window} possible seasons per player.`} Negative contribution remains visible.</p>
        <div class="mb-table-scroll" role="region" aria-label={`${viewLabel(v)} player records, scroll horizontally`} tabindex="0">
          <table><caption>{viewLabel(v)} · complete matched export</caption><thead><tr><th scope="col">Player / NBA ID</th><th scope="col">Teams</th><th scope="col"><DefinitionHelp id={`mb-observed-build-${v.id}`} label="Observed seasons">The active matched seasons included for this player. The count after them gives observed seasons out of the selected window. Averages use the observed matched seasons.</DefinitionHelp></th><th scope="col">{v.window === 1 ? 'Compensation (USD)' : 'Avg compensation (end-cap USD)'}</th><th scope="col">% cap</th><th scope="col">LEBRON rate</th><th scope="col">LEBRON above / below reference</th><th scope="col">LEBRON Value for pay percentile</th><th scope="col">{v.window === 1 ? 'WAR total' : 'Avg WAR / observed season'}</th><th scope="col">WAR above / below reference</th><th scope="col">WAR Value for pay percentile</th><th scope="col">Evidence notes</th></tr></thead><tbody>{v.players.map(p => <tr><th scope="row">{p.name}<small>{p.id}</small></th><td>{p.teams.join(', ')}</td><td>{p.observedSeasons.join(', ')} ({p.observedSeasons.length}/{v.window})</td><td>{money(p.salaryUsd)}</td><td>{decimal(p.salaryCapShare * 100)}%</td><td>{decimal(p.lebron)}</td><td>{decimal(p.residual.lebron)}</td><td>{percentile(p.valuePercentile.lebron)}</td><td>{decimal(p.war)}</td><td>{decimal(p.residual.war)}</td><td>{percentile(p.valuePercentile.war)}</td><td>{p.flags.length ? p.flags.map(readableReason).join('; ') : 'No additional flags supplied'}</td></tr>)}</tbody></table>
        </div>
        <details><summary>Team attribution and reference evidence</summary><p class="mb-small">Coverage note: {v.coverage.note}</p>
          {v.teams.map(t => <p class="mb-small">{teamName(t.team, v.endSeason)}: {t.status === 'unavailable' ? 'compensation and WAR unavailable' : `${money(t.salaryUsd!)} compensation; ${decimal(t.war!)} WAR`} {v.window > 1 ? 'per year over the full window' : 'in the season'}. {t.attributablePlayerSeasons}/{t.eligiblePlayerSeasons} matched player-seasons assigned to this club. Broader active-source audit: {t.excludedTradeCount} trade/unknown-allocation flags and {t.excludedMissingCount} missing-data flags. Those audit counts may overlap and include ineligible rows; they do not partition the matched sample. {t.note}</p>)}
          {(['lebron', 'war'] as const).map(m => <div><h4>{metricLabel(m, v)}</h4><p>{v.models[m].name}. {v.models[m].method} {v.models[m].validation} {v.models[m].intervalLabel}</p></div>)}
        </details>
      </details>)}
    </> : <p>No reviewed records are available. Missing salary or contribution is never replaced with zero.</p>}
  </section>
  <section class="mb-methods" aria-labelledby="mb-about-title">
    <h2 id="mb-about-title">About the data and model</h2>
    <details><summary>Contribution measures</summary><p><strong>WAR</strong> estimates wins above a readily available fill-in player over playing time; zero is that replacement baseline. <strong>LEBRON</strong> is the name of an impact statistic. It estimates impact per 100 possessions, or turns with the ball; zero means league average. It is a rate, not points actually scored. <a href="https://www.bball-index.com/lebron-introduction/">Provider explanation</a>.</p></details>
    <details><summary>How the model works</summary><p>The analysis fits a league-wide relationship between matched compensation and each contribution measure. The above / below reference value is the vertical gap between a player's dot and that curve. It stays fixed under team or player filters.</p><p>For multi-season windows, salary and both contribution measures cover exactly the same observed matched active seasons. A player can have fewer observed seasons than the selected window. Read that count beside the player before comparing averages. WAR and salary cap share average the observed matched active seasons; LEBRON uses the provider's possession counts as weights. Dollar views multiply average cap share by the ending-season salary cap. Team annual averages instead divide attributable player-season totals by the full selected window length.</p>{data && <><p>{data.definitions.eligibility}</p>{data.views.map(v => <details><summary>{viewLabel(v)} model and validation</summary>{(['lebron', 'war'] as const).map(m => <p><strong>{m.toUpperCase()}:</strong> {v.models[m].name}. {v.models[m].method} {v.models[m].validation}</p>)}</details>)}</>}</details>
    <details><summary>Salary, team totals and contract rules</summary><p>Salary cap share divides reported pay by that season's league cap, putting seasons on a common spending scale. Dollar views use nominal compensation for one season and ending-season cap-equivalent annual averages for multi-season windows.</p><p>Rookie scales, minimums and maximums constrain contracts; cap normalization preserves those constraints. Team membership shows the full player record. Team totals use only attributable matched salary and summed WAR, and show exclusions for traded or missing allocations. Rate values are never summed.</p>{data && <p>{data.definitions.salary}</p>}</details>
    <details><summary>Uncertainty and limitations</summary><p>The curve and extra-$1m intervals condition on the provider's estimated scores. No individual player uncertainty is supplied. These comparisons do not isolate ability, establish spending causes performance, or predict what a signing will deliver. WAR is estimated wins above replacement, not actual team wins.</p>{data ? <><p>{data.definitions.uncertainty}</p><ul>{data.definitions.limitations.map(l => <li>{l}</li>)}</ul></> : <p>The salary/contribution match, complete season coverage and model evidence must pass validation before results can appear. This preview has no numerical findings.</p>}</details>
    <details><summary>Default build sources and release status</summary>{data ? <><p>{data.publication.note}</p><ul>{data.sources.map(s => <li><a href={s.url} rel="noreferrer">{s.label}</a> · {s.version} · retrieved {s.retrieved}</li>)}</ul></> : <p>No publishable data bundle is loaded. The selected contribution measures are BBall Index's LEBRON and LEBRON WAR. Free access alone does not establish permission to republish.</p>}<p><a href="https://github.com/nanu731/basketball-econ">Analysis and reproduction code</a>. Regular seasons only; playoffs are deferred. The <a href="https://github.com/nanu731/basketball-econ/blob/main/LICENSE">MIT license</a> covers original code, not upstream data or metrics. Free access is separate from permission to redistribute.</p></details>
  <p class="mb-small" data-mb-model></p>
  <details><summary>Current view: model, validation and sources</summary><p class="mb-small">Technical notes describe the fitted line and checks. Bootstrap means refitting resampled players; SE means standard error; pointwise means one salary position at a time. Conditional means the supplied scores are treated as fixed. A one-SE rule prefers a simpler model close to the best held-out error; REML tunes curve smoothness; model family means the type of curve.</p><p class="mb-small" data-mb-view-evidence>No interactive view evidence loaded. Default build evidence is in this section.</p></details>
  <details><summary>Coverage of the selected view</summary><p class="mb-small mb-coverage" data-mb-coverage>Interactive coverage will appear after a view loads. The default build table includes its own coverage.</p></details>
  <details data-mb-team-audit-panel hidden><summary>Team coverage audit</summary><p class="mb-small" data-mb-team-audit>No team audit is loaded.</p></details>
  <details><summary>How the Value for pay percentile is calculated</summary><p>For each contribution measure and window, the percentile compares the player's gap from the salary reference with all eligible matched players in that view. Larger gaps rank higher. It counts every smaller gap and half of every exact tie, including the player, then divides by the full cohort size. Only the displayed percentile is rounded to one decimal.</p><p>Ranking uses the exact stored residuals after JSON serialization, not the rounded gaps you see on the page. A zero gap need not be the 50th percentile; the endpoints need not be 0 and 100. Filters preserve the full league cohort. Residual spread can differ across salaries, so this rank does not measure statistical surprise, uncertainty, overall talent, causal value or return per dollar.</p></details>
  </section>
  <noscript><p>JavaScript is off. Read the default build table and model explanations on this page; interactive selection is unavailable.</p></noscript>

</section>

<script>
  import { mountMoneyball } from './moneyball';
  document.querySelectorAll<HTMLElement>('[data-moneyball]').forEach(mountMoneyball);
</script>

<style>
  /* Tighten only this project's opening so the chart stays in the first viewport. */
  :global(body:has(.moneyball) .draft-flag) { display: none; }
  :global(body.project--compact:has(.moneyball) .question-band) { padding-block: var(--space-s); }
  :global(body:has(.moneyball) .question-band .project-question) { margin-top: var(--space-xs); font-size: 1.125rem; line-height: 1.4; }
  :global(body.project--compact:has(.moneyball) .prose-band) { padding-block: var(--space-s) var(--space-l); }
  .moneyball.figure { margin-block: 0; }
  .moneyball { color: var(--green); --mb-rule: 1px solid var(--green); }
  .moneyball figure { margin: 0; }
  .mb-heading { display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-s); padding-block: 0 var(--space-xs); }
  .mb-heading p { margin: 0; }
  .mb-small, figcaption { font-size: var(--type-small); line-height: 1.5; }
  .mb-heading .mb-small { max-width: 65ch; }
  .mb-controls { border: 0; border-top: var(--mb-rule); margin: 0; padding: 0; min-width: 0; }
  .mb-primary { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-s); max-width: 32rem; padding-block: var(--space-xs); }
  .mb-secondary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-xs) var(--space-s); padding-block: var(--space-xs); }
  .moneyball .mb-filters { margin: 0; border-top: var(--mb-rule); }
  .moneyball .mb-filters > summary { font: 1rem/1.4 var(--font-body); min-height: 44px; padding-block: var(--space-xs); }
  .mb-controls label, .mb-spending { display: flex; flex-direction: column; gap: var(--space-2xs); min-width: 0; font-size: var(--type-small); }
  .mb-search, .mb-picker { grid-column: auto; }
  .moneyball select, .moneyball input, .moneyball button { font: inherit; color: inherit; border-radius: 0; min-width: 0; }
  .moneyball select, .moneyball input[type=search], .moneyball button { min-height: 44px; border: var(--mb-rule); background: var(--cream); padding: var(--space-2xs); }
  .moneyball select, .moneyball input[type=search] { width: 100%; font-size: 1rem; }
  .moneyball button { cursor: pointer; }
  .moneyball button:hover { background: var(--sand); }
  .moneyball :focus-visible { outline: 3px solid var(--green); outline-offset: 3px; }
  .mb-controls:disabled { opacity: .7; }
  .mb-secondary > button { align-self: end; font-size: var(--type-small); }
  .mb-note { margin-block: var(--space-xs); max-width: 100%; }
  .mb-chart-layout { display: grid; grid-template-columns: minmax(0, 1fr) 16rem; border-block: 2px solid var(--green); }
  .mb-plot { min-width: 0; background: var(--sand); padding: var(--space-s) var(--space-xs) var(--space-xs); }
  .mb-y { display: flex; align-items: center; flex-wrap: wrap; gap: var(--space-2xs); }
  .moneyball .mb-y :global(.definition-trigger) { font-family: var(--font-numeric); min-inline-size: 44px; }
  .mb-phone-hint { display: none; }
  .moneyball :global(svg .mb-selected-name) { font-weight: 600; }
  .mb-help-hint { display: block; margin-top: var(--space-2xs); }
  .mb-axis { font-family: var(--font-numeric); font-size: .75rem; margin: 0; font-variant-numeric: tabular-nums; }
  .mb-x { text-align: right; }
  .mb-stage { position: relative; min-height: 340px; }
  [data-mb-chart] { width: 100%; height: 340px; display: block; }
  [data-mb-contrast] { width: 100%; height: 200px; display: block; background: var(--sand); }
  .moneyball :global(svg text) { font: 12px var(--font-numeric); fill: var(--green); font-variant-numeric: tabular-nums; }
  .moneyball :global(svg .mb-name) { font-size: 12px; paint-order: stroke; stroke: var(--sand); stroke-width: 4px; stroke-linejoin: round; }
  .moneyball :global(.mb-grid) { stroke: var(--green); stroke-opacity: .18; }
  .moneyball :global(.mb-zero) { stroke: var(--green); stroke-width: 1; }
  .moneyball :global(.mb-band) { fill: var(--cream); stroke: none; }
  .moneyball :global(.mb-reference) { fill: none; stroke: var(--green); stroke-width: 2; stroke-dasharray: 7 4; }
  .moneyball :global(.mb-dot) { fill: var(--green); stroke: var(--cream); stroke-width: .8; cursor: pointer; }
  .moneyball :global(.mb-selected) { fill: var(--accent); stroke: var(--green); stroke-width: 2; }
  .moneyball :global(.mb-interval) { stroke: var(--green); stroke-opacity: .35; }
  .moneyball :global(.mb-cursor) { stroke: var(--accent); stroke-width: 2; }
  .mb-empty { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; align-items: start; padding: var(--space-m); }
  .mb-empty h3 { margin: 0 0 var(--space-xs); font-size: var(--type-h3); }
  .mb-empty p { max-width: 35ch; font-size: 1rem; margin: 0 0 var(--space-s); }
  .mb-empty[hidden], [hidden] { display: none !important; }
  .mb-selection { padding: var(--space-s); border-left: var(--mb-rule); }
  .mb-selection h3 { font-size: 1.5rem; margin: 0 0 var(--space-xs); }
  .mb-selection > p { font-size: 1rem; margin: 0 0 var(--space-s); }
  .mb-selection > .mb-small { font-size: var(--type-small); }
  .mb-comparison { display: grid; gap: var(--space-s); margin: 0; }
  .mb-comparison dt { font-size: var(--type-small); line-height: 1.4; }
  .mb-comparison dd { margin: var(--space-2xs) 0 0; font-family: var(--font-numeric); font-size: 1rem; line-height: 1.45; font-variant-numeric: tabular-nums; }
  .mb-cohort { margin-bottom: var(--space-2xs); }
  .mb-selection .mb-player-details > summary { font: 1rem/1.4 var(--font-body); }
  .mb-selection [data-mb-selected-observed] { margin-top: var(--space-2xs); }
  .mb-legend { display: flex; flex-wrap: wrap; gap: var(--space-xs) var(--space-m); font-size: var(--type-small); padding-block: var(--space-xs); }
  .mb-legend > span { display: flex; align-items: center; gap: var(--space-2xs); }
  .mb-dot-key { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--green); }
  .mb-line-key { width: 24px; border-top: 2px dashed var(--green); }
  .mb-band-key { width: 24px; height: 12px; background: var(--cream); border: 1px solid var(--green); }
  figcaption { max-width: 90ch; }
